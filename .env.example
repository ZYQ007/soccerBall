# 微信公众号配置（复制为 .env 后填写）
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# 文章默认信息
ARTICLE_AUTHOR=足球数据分析
ARTICLE_SOURCE_URL=

# 封面图路径（建议 900x500 左右，jpg/png）
COVER_IMAGE_PATH=assets/cover_default.jpg

# 发布模式: draft_only | publish
# draft_only = 只创建草稿，你在后台确认后手动发布（推荐先用这个）
# publish = 创建草稿后自动调用发布接口
PUBLISH_MODE=draft_only

# 是否开启原创声明（需公众号有原创权限）
DECLARE_ORIGINAL=false

# PushPlus 微信推送 token
PUSHPLUS_TOKEN=your_pushplus_token

# 自动生成分析（无需每天开 Cursor，定时任务会调用）
# 支持 OpenAI 或兼容接口（如 DeepSeek、硅基流动等）
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
